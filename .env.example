# Production Railway (runtime, pas besoin de rebuild)
API_PROXY_TARGET=https://erp-club-backend-production.up.railway.app

# Optionnel — legacy / build-time (le proxy runtime suffit en prod)
VITE_API_URL=https://erp-club-backend-production.up.railway.app

# Dev (`npm run dev`) — proxy Vite via `.env.development` :
#   localhost:5174/api/* → backend (Railway ou local)
# Backend local : VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# API-Football (api-sports.io) — scout map, search, live profiles
# Dev : utilisé par le plugin Vite local. Production : configurer aussi sur erp-club-backend (Render)
# Gratuit : 100 req/jour — https://www.api-football.com/documentation-v3
API_FOOTBALL_KEY=
