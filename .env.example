# Production / preview — appels directs vers le backend Render
# Inclut /analyste/* (module NestJS dans erp-club-backend)
VITE_API_URL=https://erp-club-backend.onrender.com

# Dev (`npm run dev`) — proxy Vite via `.env.development` :
#   localhost:5174/api/* → backend (Render ou local)
# Backend local : VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# API-Football (api-sports.io) — Carte Explorer : toutes ligues, équipes, effectifs, transferts
# Gratuit : 100 req/jour — https://www.api-football.com/documentation-v3
API_FOOTBALL_KEY=
