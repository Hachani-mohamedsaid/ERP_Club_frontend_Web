# Production / preview — appels directs vers Render
VITE_API_URL=https://erp-club-backend.onrender.com

# En dev (`npm run dev`), `.env.development` utilise le proxy :
#   localhost:5174/api/* → https://erp-club-backend.onrender.com/*
# Backend local optionnel : VITE_API_PROXY_TARGET=http://127.0.0.1:3000
